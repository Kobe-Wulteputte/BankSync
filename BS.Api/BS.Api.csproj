<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dotnet-WorkerService1-E5CE90F1-E481-41AF-9BC9-2DCE350E8F92</UserSecretsId>
        <RootNamespace>BS.Api</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\BS.Logic\BS.Logic.csproj" />
    </ItemGroup>

    <!--
      Configuration and the signing key are shared with BS.Console rather than duplicated, so the
      two processes cannot drift into disagreeing about banks, file paths or credentials.
    -->
    <ItemGroup>
        <Content Include="..\BS.Console\appsettings.json" Link="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\BS.Console\4a77f9d9-84e2-448e-a9bd-01075cb9ddc7.pem" Link="4a77f9d9-84e2-448e-a9bd-01075cb9ddc7.pem">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
